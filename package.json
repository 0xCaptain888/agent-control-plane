{
  "name": "@captain/agent-control-plane",
  "private": true,
  "version": "0.1.0",
  "description": "Policy-controlled, verifiable execution infrastructure for autonomous AI agents.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test examples/judge-demo.test.mjs examples/safe-trade/test/*.test.mjs examples/api-procurement/test/*.test.mjs examples/okx-trade/test/*.test.mjs examples/agent-commerce/test/*.test.mjs examples/treasury-guard/test/*.test.mjs && tsx --test apps/api/test/*.test.ts packages/observability/test/*.test.ts packages/receipts/test/*.test.ts packages/control-plane/test/*.test.ts packages/marketplace/test/*.test.ts packages/persistence/test/*.test.ts packages/tenancy/test/*.test.ts packages/reliability/test/*.test.ts adapters/x402/test/*.test.ts adapters/bnb/test/*.test.ts adapters/erc8004/test/*.test.ts adapters/erc8183/test/*.test.ts adapters/okx/test/*.test.ts adapters/solana/test/*.test.ts",
    "api:dev": "tsx apps/api/src/start.ts",
    "db:backup": "node scripts/backup-postgres.mjs",
    "db:restore": "node scripts/restore-postgres.mjs",
    "demo:judge": "node scripts/judge-demo.mjs",
    "demo:bnb": "tsx examples/bnb-agent-marketplace/src/demo.ts",
    "demo:bnb:rpc": "tsx examples/bnb-agent-marketplace/src/rpc-check.ts",
    "demo:bnb:evidence": "tsx examples/bnb-agent-marketplace/src/evidence-check.ts",
    "demo:bnb:send-proof": "tsx examples/bnb-agent-marketplace/src/send-proof.ts",
    "demo:bnb:receipt": "tsx examples/bnb-agent-marketplace/src/receipt-demo.ts",
    "demo:bnb:register-identity": "tsx examples/bnb-agent-marketplace/src/register-identity.ts",
    "demo:bnb:erc8183-check": "tsx examples/bnb-agent-marketplace/src/erc8183-check.ts",
    "demo:bnb:create-task": "tsx examples/bnb-agent-marketplace/src/create-erc8183-task.ts",
    "demo:bnb:task": "tsx examples/bnb-agent-marketplace/src/erc8183-task-check.ts",
    "demo:bnb:complete-task": "tsx examples/bnb-agent-marketplace/src/complete-erc8183-task.ts",
    "demo:bnb:domain-activities": "tsx examples/bnb-agent-marketplace/src/domain-activities.ts",
    "demo:bnb:claim-u": "tsx examples/bnb-agent-marketplace/src/claim-u-token.ts",
    "demo:bnb:settle-task": "tsx examples/bnb-agent-marketplace/src/settle-erc8183-task.ts",
    "demo:bnb:find-settlement": "tsx examples/bnb-agent-marketplace/src/find-settlement-tx.ts",
    "demo:arbitrum:deploy": "node scripts/arbitrum-deploy.mjs",
    "demo:arbitrum:task": "node scripts/arbitrum-task-demo.mjs",
    "mainnet:preflight": "tsx scripts/mainnet-preflight.ts",
    "security:preflight": "node scripts/security-preflight.mjs",
    "submission:check": "npm run lint && npm run typecheck && npm test && npm run demo:judge",
    "measure:bnb": "tsx examples/bnb-agent-marketplace/src/measure.ts",
    "demo:solana": "tsx examples/solana-devnet/demo.ts",
    "demo:solana:transfer": "tsx examples/solana-devnet/transfer.ts",
    "lint": "node scripts/repo-check.mjs"
  },
  "workspaces": [
    "packages/*",
    "adapters/*",
    "examples/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "overrides": {
    "rpc-websockets": "9.0.2",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "ethers": "^6.15.0",
    "solc": "^0.8.26",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4"
  }
}
