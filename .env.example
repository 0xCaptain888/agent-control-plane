# Adapter credentials belong here for local development only.
# Never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgresql://localhost/agentguard_dev
DATABASE_POOL_MAX=10
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
AUTH_ISSUER_URL=
AUTH_AUDIENCE=agentguard-api
AUTH_MODE=development
API_HOST=127.0.0.1
API_PORT=4180

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com
OKX_DEMO_TRADING=true

# Prefer the local OKX Trade Kit profile for MCP/CLI use. The profile keeps
# credentials outside this repository.
OKX_PROFILE=okx-demo-current
OKX_MCP_READ_ONLY=true
OKX_MCP_MODULES=market,account,spot

# Public testnet RPC defaults for hackathon development. Replace these with
# Alchemy/Helius/QuickNode URLs when higher rate limits are needed.
EVM_RPC_URL=https://sepolia.base.org
EVM_RPC_URL_ETHEREUM=https://ethereum-sepolia-rpc.publicnode.com
EVM_RPC_URL_ARBITRUM=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_KEYCHAIN_SERVICE=agentguard-arbitrum-sepolia-wallet-20260825
ARBITRUM_VERIFIER_KEYCHAIN_SERVICE=agentguard-arbitrum-sepolia-verifier-v3-20260825
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_FALLBACK_URL=https://api.devnet.solana.com
SOLANA_DEVNET_KEYPAIR_PATH=~/.config/solana/agent-control-plane-devnet.json
SOLANA_DEVNET_PUBLIC_KEY=
SOLANA_MAINNET_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/<alchemy-api-key>

# BNB AgentGuard Marketplace (testnet only; chain ID 97)
BNB_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BNB_CHAIN_ID=97
BNB_EXPLORER_URL=https://testnet.bscscan.com
BNB_ERC8004_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
BNB_ERC8183_COMMERCE=0xa206c0517b6371c6638cd9e4a42cc9f02a33b0de
BNB_ERC8183_ROUTER=0xd7d36d66d2f1b608a0f943f722d27e3744f66f25
BNB_ERC8183_POLICY=0xd6a4217588f6b1f5657a92a3e94e6422ad771cea

# BNB mainnet is disabled by default. Configure only for a reviewed canary.
BNB_MAINNET_RPC_URL=
ALLOW_MAINNET_EXECUTION=false
MAINNET_CHANGE_TICKET=
