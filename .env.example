# Adapter credentials belong here for local development only.
# Never commit real secrets.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com
OKX_DEMO_TRADING=true

# Prefer the local OKX Trade Kit profile for MCP/CLI use. The profile keeps
# credentials outside this repository.
OKX_PROFILE=okx-demo-current
OKX_MCP_READ_ONLY=true
OKX_MCP_MODULES=market,account,spot

# Public testnet RPC defaults for hackathon development. Replace these with
# Alchemy/Helius/QuickNode URLs when higher rate limits are needed.
EVM_RPC_URL=https://sepolia.base.org
EVM_RPC_URL_ETHEREUM=https://ethereum-sepolia-rpc.publicnode.com
EVM_RPC_URL_ARBITRUM=https://sepolia-rollup.arbitrum.io/rpc
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/<alchemy-api-key>
